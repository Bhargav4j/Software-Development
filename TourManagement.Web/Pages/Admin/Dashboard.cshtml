@page
@model TourManagement.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row">
    <div class="col-md-12">
        <h2>Admin Dashboard - Welcome @Model.AdminName</h2>
        <hr />
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5 class="card-title">Manage Tours</h5>
                <p class="card-text">Add, edit, or delete tour packages.</p>
                <a asp-page="/Admin/Tours/Index" class="btn btn-light">Manage Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5 class="card-title">Manage Users</h5>
                <p class="card-text">View and manage registered users.</p>
                <a asp-page="/Admin/Users/Index" class="btn btn-light">Manage Users</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">All Bookings</h5>
                <p class="card-text">View and manage all tour bookings.</p>
                <a asp-page="/Admin/Bookings/Index" class="btn btn-light">View Bookings</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-12">
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="btn btn-danger">Logout</button>
        </form>
    </div>
</div>
