@page
@model TourManagement.Web.Pages.Admin.Tours.IndexModel
@{
    ViewData["Title"] = "Manage Tours";
}

<div class="row">
    <div class="col-md-12">
        <h2>Manage Tours</h2>
        <hr />
        <a asp-page="/Admin/Tours/Create" class="btn btn-success mb-3">Add New Tour</a>
    </div>
</div>

@if (Model.Tours != null && Model.Tours.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Tour Name</th>
                <th>Place</th>
                <th>Days</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tour in Model.Tours)
            {
                <tr>
                    <td>@tour.TourName</td>
                    <td>@tour.Place</td>
                    <td>@tour.Days</td>
                    <td>$@tour.Price.ToString("N2")</td>
                    <td>
                        <a asp-page="/Admin/Tours/Edit" asp-route-id="@tour.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-page="/Admin/Tours/Delete" asp-route-id="@tour.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">No tours found.</div>
}

<a asp-page="/Admin/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
