@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="row">
    <div class="col-md-12">
        <h2>Available Tours</h2>
        <hr />
    </div>
</div>

@if (Model.Tours != null && Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    @if (!string.IsNullOrEmpty(tour.PicturePath))
                    {
                        <img src="~/images/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-white">No Image Available</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">
                            <strong>Destination:</strong> @tour.Place<br />
                            <strong>Duration:</strong> @tour.Days days<br />
                            <strong>Price:</strong> $@tour.Price.ToString("N2")
                        </p>
                        <a asp-page="/Tours/Details" asp-route-id="@tour.Id" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">No tours available at the moment.</div>
}
