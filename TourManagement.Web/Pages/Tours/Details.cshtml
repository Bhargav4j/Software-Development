@page
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
                {
                    <img src="~/images/@Model.Tour.PicturePath" class="card-img-top" alt="@Model.Tour.TourName">
                }
                <div class="card-body">
                    <h2 class="card-title">@Model.Tour.TourName</h2>
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Destination:</strong> @Model.Tour.Place</p>
                            <p><strong>Duration:</strong> @Model.Tour.Days days</p>
                            <p><strong>Price:</strong> $@Model.Tour.Price.ToString("N2")</p>
                        </div>
                        <div class="col-md-6">
                            @if (!string.IsNullOrEmpty(Model.Tour.Locations))
                            {
                                <p><strong>Locations:</strong> @Model.Tour.Locations</p>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Tour.TourInfo))
                    {
                        <div class="mt-3">
                            <h4>Tour Information</h4>
                            <p>@Model.Tour.TourInfo</p>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5>Book This Tour</h5>
                    <p class="text-muted">Ready to embark on this adventure?</p>
                    <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.Id" class="btn btn-success btn-lg w-100">Book Now</a>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <a asp-page="/Tours/Index" class="btn btn-secondary">Back to Tours</a>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to Tours</a>
}
