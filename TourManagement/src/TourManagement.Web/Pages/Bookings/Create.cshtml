@page
@model TourManagement.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Book Tour";
}

<h1>Book Tour</h1>

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-6">
            <h3>Tour Information</h3>
            <dl class="row">
                <dt class="col-sm-4">Tour Name:</dt>
                <dd class="col-sm-8">@Model.Tour.TourName</dd>

                <dt class="col-sm-4">Place:</dt>
                <dd class="col-sm-8">@Model.Tour.Place</dd>

                <dt class="col-sm-4">Days:</dt>
                <dd class="col-sm-8">@Model.Tour.Days</dd>

                <dt class="col-sm-4">Price:</dt>
                <dd class="col-sm-8">$@Model.Tour.Price.ToString("N2")</dd>
            </dl>
        </div>

        <div class="col-md-6">
            <h3>Booking Details</h3>
            <form method="post">
                <input type="hidden" asp-for="TourId" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-success">Confirm Booking</button>
                    <a asp-page="/Tours/Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to Tours</a>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
