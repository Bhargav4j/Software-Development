@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h1>Available Tours</h1>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<div class="row">
    @if (Model.Tours != null && Model.Tours.Any())
    {
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(tour.PicturePath))
                    {
                        <img src="~/uploads/tours/@tour.PicturePath" class="card-img-top tour-image" alt="@tour.TourName">
                    }
                    else
                    {
                        <div class="card-img-top tour-image bg-secondary d-flex align-items-center justify-content-center">
                            <span class="text-white">No Image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text"><strong>Place:</strong> @tour.Place</p>
                        <p class="card-text"><strong>Days:</strong> @tour.Days</p>
                        <p class="card-text"><strong>Price:</strong> $@tour.Price.ToString("N2")</p>
                        <p class="card-text"><strong>Locations:</strong> @tour.Locations</p>
                        @if (!string.IsNullOrEmpty(tour.TourInfo))
                        {
                            <p class="card-text">@tour.TourInfo</p>
                        }
                        <a asp-page="/Tours/Details" asp-route-id="@tour.Id" class="btn btn-primary">View Details</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id" class="btn btn-success">Book Now</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p>No tours available at this time.</p>
        </div>
    }
</div>
