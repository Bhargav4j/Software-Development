@page
@model TourManagement.Web.Pages.Tour.IndexModel
@{
    ViewData["Title"] = "Available Tours";
}

<div class="container mt-5">
    <h2 class="mb-4">Available Tours</h2>

    @if (Model.Tours != null && Model.Tours.Any())
    {
        <div class="row">
            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(tour.PicturePath))
                        {
                            <img src="~/images/tours/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-white">No Image</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text">
                                <strong>Place:</strong> @tour.Place<br />
                                <strong>Days:</strong> @tour.Days<br />
                                <strong>Price:</strong> $@tour.Price<br />
                                <strong>Locations:</strong> @tour.Locations
                            </p>
                            <p class="card-text"><small>@tour.TourInfo</small></p>
                        </div>
                        <div class="card-footer">
                            <a asp-page="/Tour/Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">Details</a>
                            <a asp-page="/Booking/Create" asp-route-tourId="@tour.TourId" class="btn btn-success btn-sm">Book Now</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No tours available at the moment.</div>
    }

    <div class="mt-3">
        <a asp-page="/Admin/Login" class="btn btn-warning">Admin Login</a>
    </div>
</div>
