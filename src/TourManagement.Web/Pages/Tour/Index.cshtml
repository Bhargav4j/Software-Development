@page
@model TourIndexModel
@{
    ViewData["Title"] = "Tours";
}

<h2>Available Tours</h2>

@if (Model.Tours != null && Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card tour-card">
                    @if (!string.IsNullOrEmpty(tour.PicturePath))
                    {
                        <img src="~/uploads/tour-pictures/@tour.PicturePath" class="card-img-top tour-image" alt="@tour.TourName" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/300x200?text=Tour+Image" class="card-img-top tour-image" alt="@tour.TourName" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">
                            <strong>Place:</strong> @tour.Place<br />
                            <strong>Days:</strong> @tour.Days<br />
                            <strong>Price:</strong> $@tour.Price.ToString("N2")<br />
                            <strong>Locations:</strong> @tour.Locations
                        </p>
                        <a asp-page="/Tour/Details" asp-route-id="@tour.TourId" class="btn btn-primary">View Details</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-page="/Booking/Create" asp-route-tourId="@tour.TourId" class="btn btn-success">Book Now</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No tours available at the moment.
    </div>
}

@if (User.IsInRole("Admin"))
{
    <div class="mt-3">
        <a asp-page="/Admin/Tours/Create" class="btn btn-primary">Add New Tour</a>
    </div>
}
