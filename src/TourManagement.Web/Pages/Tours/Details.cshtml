@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h1>Tour Details</h1>

<div>
    <hr />
    @if (Model.Tour != null)
    {
        <div class="row">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.Tour.PictureFileName))
                {
                    <img src="~/Tour_pics/@Model.Tour.PictureFileName" class="img-fluid" alt="@Model.Tour.Name" />
                }
                else
                {
                    <div style="height: 300px; background-color: #e9ecef; display: flex; align-items: center; justify-content: center;">
                        <span class="text-muted">No Image</span>
                    </div>
                }
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Tour Name</dt>
                    <dd class="col-sm-8">@Model.Tour.Name</dd>

                    <dt class="col-sm-4">Place</dt>
                    <dd class="col-sm-8">@Model.Tour.Place</dd>

                    <dt class="col-sm-4">Days</dt>
                    <dd class="col-sm-8">@Model.Tour.Days</dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">$@Model.Tour.Price</dd>

                    <dt class="col-sm-4">Locations</dt>
                    <dd class="col-sm-8">@Model.Tour.Locations</dd>

                    <dt class="col-sm-4">Tour Information</dt>
                    <dd class="col-sm-8">@Model.Tour.TourInfo</dd>

                    <dt class="col-sm-4">Created Date</dt>
                    <dd class="col-sm-8">@Model.Tour.CreatedDate.ToString("MM/dd/yyyy")</dd>
                </dl>

                <div class="mt-3">
                    <a asp-page="Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning">Edit</a>
                    <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.Id" class="btn btn-success">Book Now</a>
                    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <p>Tour not found.</p>
    }
</div>
