@page
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<h1>Tour Details</h1>

<hr />

@if (Model.Tour != null)
{
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.PicturePath))
            {
                <img src="~/uploads/@Model.Tour.PicturePath" class="img-fluid rounded" alt="@Model.Tour.TourName">
            }
            else
            {
                <div class="bg-secondary d-flex align-items-center justify-content-center rounded" style="height: 400px;">
                    <span class="text-white">No Image Available</span>
                </div>
            }
        </div>
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Tour Name</dt>
                <dd class="col-sm-8">@Model.Tour.TourName</dd>

                <dt class="col-sm-4">Place</dt>
                <dd class="col-sm-8">@Model.Tour.Place</dd>

                <dt class="col-sm-4">Days</dt>
                <dd class="col-sm-8">@Model.Tour.Days</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">$@Model.Tour.Price.ToString("N2")</dd>

                <dt class="col-sm-4">Locations</dt>
                <dd class="col-sm-8">@Model.Tour.Locations</dd>

                <dt class="col-sm-4">Tour Information</dt>
                <dd class="col-sm-8">@Model.Tour.TourInfo</dd>

                <dt class="col-sm-4">Created Date</dt>
                <dd class="col-sm-8">@Model.Tour.CreatedDate.ToString("MMM dd, yyyy")</dd>
            </dl>

            <div class="mt-3">
                <a asp-page="Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning">Edit</a>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        Tour not found.
    </div>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}
