@page
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingPic" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="TourName" class="control-label"></label>
                <input asp-for="TourName" class="form-control" />
                <span asp-validation-for="TourName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Place" class="control-label"></label>
                <input asp-for="Place" class="form-control" />
                <span asp-validation-for="Place" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Days" class="control-label"></label>
                <input asp-for="Days" class="form-control" type="number" />
                <span asp-validation-for="Days" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Locations" class="control-label"></label>
                <input asp-for="Locations" class="form-control" />
                <span asp-validation-for="Locations" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="TourInfo" class="control-label"></label>
                <textarea asp-for="TourInfo" class="form-control" rows="4"></textarea>
                <span asp-validation-for="TourInfo" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ExistingPic))
            {
                <div class="form-group mb-3">
                    <label>Current Image</label><br />
                    <img src="~/images/@Model.ExistingPic" alt="Current" style="max-width: 200px;" />
                </div>
            }

            <div class="form-group mb-3">
                <label asp-for="ImageFile" class="control-label">New Image (optional)</label>
                <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
