@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Input.Id" />
            <input type="hidden" asp-for="Input.ExistingPictureFileName" />

            <div class="mb-3">
                <label asp-for="Input.TourName" class="form-label">Tour Name</label>
                <input asp-for="Input.TourName" class="form-control" />
                <span asp-validation-for="Input.TourName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Place" class="form-label">Place</label>
                <input asp-for="Input.Place" class="form-control" />
                <span asp-validation-for="Input.Place" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Days" class="form-label">Days</label>
                <input asp-for="Input.Days" type="number" class="form-control" />
                <span asp-validation-for="Input.Days" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Price" class="form-label">Price</label>
                <input asp-for="Input.Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Input.Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Locations" class="form-label">Locations</label>
                <input asp-for="Input.Locations" class="form-control" />
                <span asp-validation-for="Input.Locations" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.TourInfo" class="form-label">Tour Information</label>
                <textarea asp-for="Input.TourInfo" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Input.ExistingPictureFileName))
            {
                <div class="mb-3">
                    <label class="form-label">Current Picture</label><br />
                    <img src="~/uploads/tours/@Model.Input.ExistingPictureFileName" alt="Current" style="max-width: 200px;" />
                </div>
            }

            <div class="mb-3">
                <label asp-for="Input.PictureFile" class="form-label">New Picture (optional)</label>
                <input asp-for="Input.PictureFile" type="file" class="form-control" accept="image/*" />
                <span asp-validation-for="Input.PictureFile" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
