@page
@model CreateTourModel
@{
    ViewData["Title"] = "Create Tour";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-body">
                <h2>Add New Tour</h2>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }

                <form method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label asp-for="TourName" class="form-label">Tour Name</label>
                        <input asp-for="TourName" class="form-control" />
                        <span asp-validation-for="TourName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Place" class="form-label">Place</label>
                        <input asp-for="Place" class="form-control" />
                        <span asp-validation-for="Place" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Days" class="form-label">Days</label>
                        <input asp-for="Days" class="form-control" type="number" />
                        <span asp-validation-for="Days" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label">Price</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Locations" class="form-label">Locations</label>
                        <input asp-for="Locations" class="form-control" />
                        <span asp-validation-for="Locations" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TourInfo" class="form-label">Tour Information</label>
                        <textarea asp-for="TourInfo" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="TourInfo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PictureFile" class="form-label">Tour Picture</label>
                        <input asp-for="PictureFile" class="form-control" type="file" accept="image/*" />
                        <span asp-validation-for="PictureFile" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Create Tour</button>
                        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
