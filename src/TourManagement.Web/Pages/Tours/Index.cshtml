@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h1>Tours</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New Tour</a>
</p>

<div class="row">
    @foreach (var tour in Model.Tours)
    {
        <div class="col-md-4 mb-4">
            <div class="card">
                @if (!string.IsNullOrEmpty(tour.Pic))
                {
                    <img src="~/images/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;">
                }
                else
                {
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                        <span class="text-white">No Image</span>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@tour.TourName</h5>
                    <p class="card-text">
                        <strong>Place:</strong> @tour.Place<br />
                        <strong>Days:</strong> @tour.Days<br />
                        <strong>Price:</strong> $@tour.Price.ToString("N2")
                    </p>
                    <a asp-page="Details" asp-route-id="@tour.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="Edit" asp-route-id="@tour.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@tour.Id" class="btn btn-sm btn-danger">Delete</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours available.</div>
}
