@page
@model ToursIndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="row">
    <div class="col-md-12">
        <h2>@ViewData["Title"]</h2>
        <hr />
        <div class="row">
            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        @if (!string.IsNullOrEmpty(tour.PicturePath))
                        {
                            <img src="~/images/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary" style="height: 200px;"></div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text">@tour.Place</p>
                            <p class="card-text"><strong>Days:</strong> @tour.Days</p>
                            <p class="card-text"><strong>Price:</strong> $@tour.Price</p>
                            <a asp-page="/Tours/Details" asp-route-id="@tour.Id" class="btn btn-primary">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
