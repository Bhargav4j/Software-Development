@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h1>Available Tours</h1>

<p>
    <a asp-page="Create" class="btn btn-success">Add New Tour</a>
</p>

@if (Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(tour.PicturePath))
                    {
                        <img src="~/uploads/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span class="text-white">No Image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">
                            <strong>Place:</strong> @tour.Place<br />
                            <strong>Days:</strong> @tour.Days<br />
                            <strong>Price:</strong> $@tour.Price.ToString("N2")<br />
                            <strong>Locations:</strong> @tour.Locations
                        </p>
                        <p class="card-text">@tour.TourInfo</p>
                    </div>
                    <div class="card-footer">
                        <a asp-page="Details" asp-route-id="@tour.TourId" class="btn btn-primary btn-sm">Details</a>
                        <a asp-page="Edit" asp-route-id="@tour.TourId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-page="Delete" asp-route-id="@tour.TourId" class="btn btn-danger btn-sm">Delete</a>
                        <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-success btn-sm">Book Now</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No tours available. <a asp-page="Create">Add a new tour</a>
    </div>
}
