@page
@model ToursIndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Available Tours</h1>
        @if (Model.HttpContext.Session.GetString("IsAdmin") == "true")
        {
            <a asp-page="Create" class="btn btn-success">Add New Tour</a>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    @if (Model.Tours != null && Model.Tours.Any())
    {
        <div class="row">
            @foreach (var tour in Model.Tours)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        @if (!string.IsNullOrEmpty(tour.PicturePath))
                        {
                            <img src="~/uploads/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-white">No Image</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@tour.TourName</h5>
                            <p class="card-text">
                                <strong>Place:</strong> @tour.Place<br />
                                <strong>Days:</strong> @tour.Days<br />
                                <strong>Price:</strong> $@tour.Price.ToString("N2")
                            </p>
                            <div class="d-grid gap-2">
                                <a asp-page="Details" asp-route-id="@tour.Id" class="btn btn-primary">View Details</a>
                                @if (Model.HttpContext.Session.GetString("IsAdmin") == "true")
                                {
                                    <a asp-page="Edit" asp-route-id="@tour.Id" class="btn btn-warning">Edit</a>
                                    <a asp-page="Delete" asp-route-id="@tour.Id" class="btn btn-danger">Delete</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">No tours available at the moment.</div>
    }
</div>
