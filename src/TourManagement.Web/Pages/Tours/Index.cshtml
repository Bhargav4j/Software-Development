@page
@model TourManagement.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h1>Available Tours</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Tour</a>
</p>

<form method="get">
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tours..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-secondary">Search</button>
        </div>
    </div>
</form>

@if (Model.Tours != null && Model.Tours.Any())
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    @if (!string.IsNullOrEmpty(tour.PictureFileName))
                    {
                        <img src="~/Tour_pics/@tour.PictureFileName" class="card-img-top" alt="@tour.Name" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div style="height: 200px; background-color: #e9ecef; display: flex; align-items: center; justify-content: center;">
                            <span class="text-muted">No Image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.Name</h5>
                        <p class="card-text">
                            <strong>Place:</strong> @tour.Place<br />
                            <strong>Days:</strong> @tour.Days<br />
                            <strong>Price:</strong> $@tour.Price<br />
                            <strong>Locations:</strong> @tour.Locations
                        </p>
                        <p class="card-text">@tour.TourInfo</p>
                        <div class="btn-group" role="group">
                            <a asp-page="Details" asp-route-id="@tour.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="Edit" asp-route-id="@tour.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="Delete" asp-route-id="@tour.Id" class="btn btn-sm btn-danger">Delete</a>
                            <a asp-page="/Bookings/Create" asp-route-tourId="@tour.Id" class="btn btn-sm btn-success">Book Now</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No tours available.</p>
}
