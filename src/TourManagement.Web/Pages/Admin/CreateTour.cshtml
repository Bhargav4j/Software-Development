@page
@model TourManagement.Web.Pages.Admin.CreateTourModel
@{
    ViewData["Title"] = "Create Tour";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h3>Create New Tour</h3>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="Input.TourName" class="form-label">Tour Name</label>
                    <input asp-for="Input.TourName" class="form-control" required />
                    <span asp-validation-for="Input.TourName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Place" class="form-label">Place</label>
                    <input asp-for="Input.Place" class="form-control" required />
                    <span asp-validation-for="Input.Place" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Days" class="form-label">Days</label>
                    <input asp-for="Input.Days" class="form-control" type="number" required />
                    <span asp-validation-for="Input.Days" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Price" class="form-label">Price</label>
                    <input asp-for="Input.Price" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="Input.Price" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Locations" class="form-label">Locations</label>
                    <input asp-for="Input.Locations" class="form-control" required />
                    <span asp-validation-for="Input.Locations" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.TourInfo" class="form-label">Tour Information</label>
                    <textarea asp-for="Input.TourInfo" class="form-control" rows="4" required></textarea>
                    <span asp-validation-for="Input.TourInfo" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.PictureFile" class="form-label">Tour Picture</label>
                    <input asp-for="Input.PictureFile" class="form-control" type="file" accept="image/*" />
                    <span asp-validation-for="Input.PictureFile" class="text-danger"></span>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success">Create Tour</button>
                    <a asp-page="/Admin/Tours" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
