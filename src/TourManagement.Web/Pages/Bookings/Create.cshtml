@page
@model TourManagement.Web.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Book Tour";
}

<h1>Book Tour: @Model.Tour?.TourName</h1>

@if (Model.Tour != null)
{
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tour Details</h5>
                    <p><strong>Place:</strong> @Model.Tour.Place</p>
                    <p><strong>Duration:</strong> @Model.Tour.Days days</p>
                    <p><strong>Price per person:</strong> $@Model.Tour.Price</p>
                    <p><strong>Locations:</strong> @Model.Tour.Locations</p>
                    <p>@Model.Tour.TourInfo</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <form method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for="BookingInput.TourId" />

                <div class="form-group mb-3">
                    <label asp-for="BookingInput.BookingDate" class="control-label"></label>
                    <input asp-for="BookingInput.BookingDate" class="form-control" type="date" />
                    <span asp-validation-for="BookingInput.BookingDate" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="BookingInput.NumberOfPeople" class="control-label"></label>
                    <input asp-for="BookingInput.NumberOfPeople" class="form-control" type="number" min="1" />
                    <span asp-validation-for="BookingInput.NumberOfPeople" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <p><strong>Total Amount:</strong> $<span id="totalAmount">@(Model.Tour.Price)</span></p>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-success">Confirm Booking</button>
                    <a asp-page="/Tours/Index" class="btn btn-secondary">Back to Tours</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <p class="alert alert-danger">Tour not found.</p>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const pricePerPerson = @Model.Tour?.Price ?? 0;
            const numberOfPeopleInput = document.querySelector('input[name="BookingInput.NumberOfPeople"]');
            const totalAmountSpan = document.getElementById('totalAmount');

            numberOfPeopleInput?.addEventListener('input', function() {
                const numberOfPeople = parseInt(this.value) || 1;
                const totalAmount = pricePerPerson * numberOfPeople;
                totalAmountSpan.textContent = totalAmount.toFixed(2);
            });
        });
    </script>
}
