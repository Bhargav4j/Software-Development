@page
@model TourManagement.Web.Pages.User.ProfileModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h3>User Profile</h3>
                </div>
                <div class="card-body">
                    @if (Model.UserInfo != null)
                    {
                        <table class="table">
                            <tr>
                                <th>Email:</th>
                                <td>@Model.UserInfo.Email</td>
                            </tr>
                            <tr>
                                <th>Name:</th>
                                <td>@Model.UserInfo.FirstName @Model.UserInfo.LastName</td>
                            </tr>
                            <tr>
                                <th>Gender:</th>
                                <td>@Model.UserInfo.Gender</td>
                            </tr>
                            <tr>
                                <th>Date of Birth:</th>
                                <td>@Model.UserInfo.DateOfBirth.ToShortDateString()</td>
                            </tr>
                            <tr>
                                <th>Address:</th>
                                <td>@Model.UserInfo.Street, @Model.UserInfo.City, @Model.UserInfo.State</td>
                            </tr>
                        </table>
                        <div class="mt-3">
                            <a asp-page="/Tour/Index" class="btn btn-primary">View Tours</a>
                            <a asp-page="/Booking/MyBookings" class="btn btn-info">My Bookings</a>
                            <a asp-page="/User/Logout" class="btn btn-danger">Logout</a>
                        </div>
                    }
                    else
                    {
                        <p>Please login to view your profile.</p>
                        <a asp-page="/User/Login" class="btn btn-primary">Login</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
