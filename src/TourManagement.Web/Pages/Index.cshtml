@page
@model TourManagement.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management System</h1>
    <p class="lead">Discover amazing tours and book your next adventure!</p>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Browse Tours</h5>
                    <p class="card-text">Explore our collection of exciting tours to destinations around the world.</p>
                    <a asp-page="/Tours/Index" class="btn btn-primary">View Tours</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Create Account</h5>
                    <p class="card-text">Register for an account to book tours and manage your bookings.</p>
                    <a asp-page="/Users/Register" class="btn btn-success">Register Now</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">My Bookings</h5>
                    <p class="card-text">View and manage your tour bookings from your account.</p>
                    <a asp-page="/Bookings/Index" class="btn btn-info">View Bookings</a>
                </div>
            </div>
        </div>
    </div>
</div>
