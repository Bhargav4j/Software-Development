@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Tour Management</h1>
    <p class="lead">Discover amazing tours and book your next adventure</p>
    <div class="mt-4">
        <a asp-page="/Tours/Index" class="btn btn-primary btn-lg">Browse Tours</a>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Discover Tours</h5>
                <p class="card-text">Browse through our collection of exciting tours</p>
                <a asp-page="/Tours/Index" class="btn btn-outline-primary">View Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Easy Booking</h5>
                <p class="card-text">Book your favorite tours with just a few clicks</p>
                <a asp-page="/Users/Register" class="btn btn-outline-primary">Get Started</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Manage Bookings</h5>
                <p class="card-text">Track and manage all your tour bookings</p>
                <a asp-page="/Users/Login" class="btn btn-outline-primary">Sign In</a>
            </div>
        </div>
    </div>
</div>
